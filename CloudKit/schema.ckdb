DEFINE SCHEMA

    RECORD TYPE Image (
        "___createTime"    TIMESTAMP,
        "___createdBy"     REFERENCE,
        "___etag"          STRING,
        "___modTime"       TIMESTAMP,
        "___modifiedBy"    REFERENCE,
        "___recordID"      REFERENCE QUERYABLE,
        background         STRING QUERYABLE SEARCHABLE SORTABLE,
        batchID            STRING QUERYABLE SEARCHABLE SORTABLE,
        complexity         STRING QUERYABLE SEARCHABLE SORTABLE,
        createdAt          TIMESTAMP QUERYABLE SORTABLE,
        duration           DOUBLE QUERYABLE SORTABLE,
        file               ASSET,
        fileName           STRING QUERYABLE SEARCHABLE SORTABLE,
        fileSize           INT64 QUERYABLE SORTABLE,
        frameCount         INT64 QUERYABLE SORTABLE,
        frameDurationMs    INT64 QUERYABLE SORTABLE,
        height             INT64 QUERYABLE SORTABLE,
        inputTokens        INT64 QUERYABLE SORTABLE,
        markupFileName     STRING QUERYABLE SEARCHABLE SORTABLE,
        modelID            STRING QUERYABLE SEARCHABLE SORTABLE,
        moderation         STRING QUERYABLE SEARCHABLE SORTABLE,
        outputCompression  INT64 QUERYABLE SORTABLE,
        outputFormat       STRING QUERYABLE SEARCHABLE SORTABLE,
        outputTokens       INT64 QUERYABLE SORTABLE,
        prompt             ENCRYPTED STRING,
        quality            STRING QUERYABLE SEARCHABLE SORTABLE,
        referenceFileNames LIST<STRING> QUERYABLE SEARCHABLE,
        requestedSize      STRING QUERYABLE SEARCHABLE SORTABLE,
        resolvedBackground STRING QUERYABLE SEARCHABLE SORTABLE,
        resolvedQuality    STRING QUERYABLE SEARCHABLE SORTABLE,
        revisedPrompt      ENCRYPTED STRING,
        storeFileNames     LIST<STRING> QUERYABLE SEARCHABLE,
        storeFiles         LIST<ASSET>,
        svgAuthorModel     STRING QUERYABLE SEARCHABLE SORTABLE,
        svgInputTokens     INT64 QUERYABLE SORTABLE,
        svgOutputTokens    INT64 QUERYABLE SORTABLE,
        width              INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
